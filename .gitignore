# ---------------------------------------------------------------- 依赖
node_modules/
.pnp
.pnp.*
.yarn/

# ---------------------------------------------------------------- 构建产物
# Next.js 构建输出与缓存
.next/
out/
next-env.d.ts.bak
# tsc 编译脚本用的中间产物（scripts/ tests/ 编译到 .build）
.build/
dist/
build/
*.tsbuildinfo

# ---------------------------------------------------------------- 本地数据
# 演示数据库（由 pnpm seed 生成，不入库；含测试用的临时副本）
data/*.db
data/*.db-*
data/*.sqlite
data/*.sqlite-*
!data/.gitkeep

# ---------------------------------------------------------------- 缓存与覆盖率
.npm-cache/
.npm/
.eslintcache
.stylelintcache
coverage/
.vercel/
.turbo/

# ---------------------------------------------------------------- 环境变量
.env
.env.*
!.env.example

# ---------------------------------------------------------------- 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------------------------------------------------- 系统与编辑器
.DS_Store
._*
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# ---------------------------------------------------------------- Office 临时文件
# Word/Excel 打开文件时生成的锁文件（~$README.md 这类）
~$*
*.tmp
*.temp

# ---------------------------------------------------------------- 本地草稿
# 参考文档解析、截图脚本、临时验证脚本，均不入库
_ref/

# 交付用的源码压缩包
*.zip
